{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma Palette",
  "version": "0.1.2",
  "identifier": "com.ubird.luma-palette-csp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Luma Palette",
        "width": 380,
        "height": 360,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": false,
        "focus": true
      },
      {
        "label": "settings",
        "title": "Luma Palette",
        "url": "settings.html",
        "width": 520,
        "height": 700,
        "decorations": true,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (C) 2026 Andy Fang and contributors",
    "homepage": "https://github.com/andyubird/LumaPaletteCSP",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
